{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "role-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",

  // Only reachable through the custom domain, which sits behind Cloudflare
  // Access. Keep workers.dev and preview URLs off so a deploy can't reopen
  // an unprotected hostname.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "role-feed.conormcleod.com", "custom_domain": true }],

  // Static feed UI, built by Vite (the plugin points the generated config at
  // dist/client, so no directory here). API routes go to the Worker first.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // database_id is filled in automatically on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "role-feed",
      "migrations_dir": "./migrations"
    }
  ],

  // One message per company, consumed one at a time, so each company's
  // fetch + parse gets its own invocation (and its own CPU budget).
  "queues": {
    "producers": [{ "binding": "FETCH_QUEUE", "queue": "role-feed-fetch" }],
    "consumers": [
      {
        "queue": "role-feed-fetch",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "role-feed-dlq"
      },
      // Messages that exhausted their retries land here, so the give-up is
      // recorded on the company instead of the message silently vanishing.
      {
        "queue": "role-feed-dlq",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },

  // Once a day, 12:00 UTC.
  "triggers": {
    "crons": ["0 12 * * *"]
  },

  // "Add to Notion" target: the Jobs database's data source. The token is a
  // secret: `wrangler secret put NOTION_TOKEN` (or NOTION_TOKEN in .dev.vars).
  "vars": {
    "NOTION_DATA_SOURCE_ID": "280a39e7-3411-8067-b6d6-000bda30499a",
    "NOTION_TITLE_PROPERTY": "Position",
    "NOTION_URL_PROPERTY": "Link"
  },
  "secrets": {
    "required": ["NOTION_TOKEN"]
  },

  "observability": {
    "enabled": true
  }
}
