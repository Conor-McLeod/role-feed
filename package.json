{
  "name": "role-feed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --tsconfig ./ui/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply role-feed --local",
    "db:migrate:remote": "wrangler d1 migrations apply role-feed --remote"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "wrangler": "4.158.0"
  }
}
